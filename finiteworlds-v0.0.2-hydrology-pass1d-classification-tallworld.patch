+    private static void drawLine(
+            BufferedImage image,
+            int x0,
+            int z0,
+            int x1,
+            int z1,
+            int color
+    ) {
+        int dx =
+                Math.abs(x1 - x0);
+
+        int dz =
+                Math.abs(z1 - z0);
+
+        int stepX =
+                x0 < x1
+                        ? 1
+                        : -1;
+
+        int stepZ =
+                z0 < z1
+                        ? 1
+                        : -1;
+
+        int error =
+                dx - dz;
+
+        int x =
+                x0;
+
+        int z =
+                z0;
+
+        while (true) {
+            if (
+                    x >= 0
+                            && x < image.getWidth()
+                            && z >= 0
+                            && z < image.getHeight()
+            ) {
+                image.setRGB(
+                        x,
+                        z,
+                        color
+                );
+            }
+
+            if (x == x1 && z == z1) {
+                break;
+            }
+
+            int doubledError =
+                    error * 2;
+
+            if (doubledError > -dz) {
+                error -= dz;
+                x += stepX;
+            }
+
+            if (doubledError < dx) {
+                error += dx;
+                z += stepZ;
+            }
+        }
+    }
