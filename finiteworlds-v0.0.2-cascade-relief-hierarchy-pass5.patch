+                        signedDistance * 5.5 + 17.0,
+                        3,
+                        2.0,
+                        0.52
+                );
+
+        double combined =
+                longSignal * 0.68
+                        + shoulderSignal * 0.32;
+
+        double normalized =
+                clamp01(
